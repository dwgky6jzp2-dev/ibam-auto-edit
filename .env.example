import express from 'express';
import { createProject, getProjectById, getProjectsByUser, getUserById, updateUserTokens } from '../db.js';

const router = express.Router();

function authRequired(req, res, next) {
  const header = req.headers.authorization || '';
  const token = header.startsWith('Bearer ') ? header.substring(7) : '';

  if (!token || !token.startsWith('token-')) {
    return res.status(401).json({ message: 'Authentication required.' });
  }

  const userId = Number(token.replace('token-', ''));
  const user = getUserById(userId);

  if (!user) {
    return res.status(401).json({ message: 'Invalid token.' });
  }

  req.user = user;
  next();
}

router.get('/', authRequired, (req, res) => {
  const projects = getProjectsByUser(req.user.id);
  return res.json({ projects });
});

router.post('/', authRequired, (req, res) => {
  const { title, youtubeUrl, prompt } = req.body;

  if (!title || !youtubeUrl || !prompt) {
    return res.status(400).json({ message: 'Title, YouTube URL and prompt are required.' });
  }

  const projectCost = 20;
  const user = getUserById(req.user.id);

  if (user.role !== 'developer' && user.tokens < projectCost) {
    return res.status(402).json({ message: 'Token Anda tidak cukup. Upgrade paket untuk melanjutkan.' });
  }

  const tokensUsed = user.role === 'developer' ? 0 : projectCost;
  const project = createProject({
    userId: user.id,
    title,
    youtubeUrl,
    prompt,
    tokensUsed,
  });

  if (user.role !== 'developer') {
    const nextTokens = user.tokens - projectCost;
    updateUserTokens(user.id, nextTokens);
  }

  project.status = 'processing';
  return res.status(201).json({ project, message: 'Project created successfully.' });
});

router.get('/:id', authRequired, (req, res) => {
  const project = getProjectById(Number(req.params.id));

  if (!project) {
    return res.status(404).json({ message: 'Project not found.' });
  }

  if (req.user.role !== 'developer' && project.user_id !== req.user.id) {
    return res.status(403).json({ message: 'You do not have access to this project.' });
  }

  return res.json({ project });
});

export default router;

